#include <Wire.h>
#include <LiquidCrystal_I2C.h>
LiquidCrystal_I2C lcd(0x27, 16, 2);

#define BTN_UP_PIN 2
#define BTN_DOWN_PIN 3

//==Target parameters==
int setPoint = 25;
const int minSetPoint = 10;
const int maxSetPoint = 40;

bool isValueChanged = true; //initial draw flag

//==Debounce state for UP button==
bool lastUpRead = HIGH;
bool stableUpState = HIGH;
unsigned long upBounceTime = 0;

//==Debounce state for DOWN Button ==
bool lastDownRead = HIGH;
bool stableDownState = HIGH;
unsigned long downBounceTime = 0;

const unsigned long debounceDelay = 50;

void setup(){
  Serial.begin(115200);
  pinMode(BTN_UP_PIN, INPUT_PULLUP);
  pinMode(BTN_DOWN_PIN, INPUT_PULLUP);
  
  lcd.init();
  lcd.backlight();
}

void loop(){
  //==Task 1 -Set Non-blocking debounce UP BUTTON==
  //1.1- Reading button
  bool currentUpRead = digitalRead(BTN_UP_PIN);
  //1.2- Detect electrical change
  if(currentUpRead != lastUpRead){
    lastUpRead = currentUpRead;
    upBounceTime = millis();
  }
  //1.3- Check debounce time
  if(millis() - upBounceTime >= debounceDelay){
    //1.4- Detect stable state
    if(currentUpRead != stableUpState){
      stableUpState = currentUpRead;
      //1.5- Valid button Press
      if(stableUpState == LOW){
        if(setPoint < maxSetPoint){
          setPoint++;
          isValueChanged = true;
          Serial.println(setPoint);
        }
      }
    }
  }
  //==Task 2 - Set non-blocking debounce Down button ==
  //2.1 - Reading electrical value
  bool currentDownRead = digitalRead(BTN_DOWN_PIN);
  //2.2 - detect electrical change
  if(currentDownRead != lastDownRead){
    lastDownRead = currentDownRead;
    downBounceTime = millis();    
  }
  //2.3 Check debounce delay time
  if(millis() - downBounceTime >= debounceDelay){
    //2.4- detect stable state
    if(currentDownRead != stableDownState){
      stableDownState = currentDownRead;
      //2.5- Valid button press
      if(stableDownState == LOW){
        if(setPoint > minSetPoint){
          setPoint--;
          isValueChanged = true;
          Serial.println(setPoint);
        }
      }
    }
  }
  //==Task 3- Render UI Values in LCD
  if(isValueChanged){
    isValueChanged = false;
     
    lcd.clear();
    lcd.setCursor(0,0);
    lcd.print("Set temperature: ");
    lcd.setCursor(5,1);
    lcd.print(setPoint);
    lcd.print((char)176);//Degree symbol
    lcd.print("C");
  }
}
